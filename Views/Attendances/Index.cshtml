@model G2AspNet.ViewModels.Attendances.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Asistencias";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Asistencias</h1>
        <p class="text-secondary mb-0">Presencia de cada alumno en cada lección.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva asistencia</a>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label for="Search" class="form-label">Buscar</label>
            <input id="Search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Lección, curso o alumno" />
        </div>
        <div class="col-md-auto"><button class="btn btn-primary" type="submit">Buscar</button></div>
    </div>
</form>

@if (Model.Attendances.Count == 0)
{
    <div class="alert alert-info">No hay asistencias que coincidan con la búsqueda.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Lección</th>
                    <th>Curso</th>
                    <th>Alumno</th>
                    <th>Fecha</th>
                    <th>Asistencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Attendances)
                {
                    var attendance = item.Attendance;
                    <tr>
                        <td class="fw-semibold">@attendance.Lesson?.Name</td>
                        <td>@attendance.Enrollment?.Course?.Name</td>
                        <td>@(attendance.Enrollment?.Student?.DisplayName ?? attendance.Enrollment?.Student?.UserName)</td>
                        <td>@attendance.Lesson?.StartDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge text-bg-secondary">@Html.DisplayFor(m => attendance.Status)</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@attendance.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@attendance.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@attendance.Id" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta asistencia?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
