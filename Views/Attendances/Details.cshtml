@model Attendance
@{
    ViewData["Title"] = "Detalle de asistencia";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Detalle de asistencia</h1>
    <div class="d-flex gap-2">
       <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta asistencia?');"><button type="submit" class="btn btn-danger">Eliminar</button></form>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Alumno</dt>
            <dd class="col-sm-9">@(Model.Enrollment?.Student?.DisplayName ?? Model.Enrollment?.Student?.UserName)</dd>
            <dt class="col-sm-3">Curso</dt>
            <dd class="col-sm-9">
                @if (Model.Enrollment?.Course is not null)
                {
                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Enrollment.Course.Id">@Model.Enrollment.Course.Name</a>
                }
            </dd>
            <dt class="col-sm-3">Lección</dt>
            <dd class="col-sm-9">
                @if (Model.Lesson is not null)
                {
                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.Lesson.Id">@Model.Lesson.Name</a>
                }
            </dd>
            <dt class="col-sm-3">Fecha de la lección</dt>
            <dd class="col-sm-9">@Model.Lesson?.StartDate.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Asistencia</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Status)</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a asistencias</a>
    </div>
</div>
