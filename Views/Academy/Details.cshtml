@model Academy
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Detalle de centro</h1>
    <div class="d-flex gap-2">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('¿Eliminar este centro?');">
            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
        </form>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h4 mb-1">@Model.Name</h2>
        <p class="text-secondary">@Model.Description</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.Address</dd>
            <dt class="col-sm-3">Ciudad</dt>
            <dd class="col-sm-9">@Model.City</dd>
            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Phone</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a centros</a>
    </div>
</div>

<h2 class="h4">Aulas</h2>
@if (Model.Classrooms.Count == 0)
{
    <div class="alert alert-info">Este centro todavía no tiene aulas.</div>
}
else
{
    <div class="table-responsive border rounded mb-4">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Aula</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var classroom in Model.Classrooms.OrderBy(c => c.Name))
                {
                    <tr>
                        <td>
                            <a asp-controller="Classroom" asp-action="Details" asp-route-id="@classroom.Id">@classroom.Name</a>
                        </td>
                        <td>@Html.DisplayFor(m => classroom.ClassroomType)</td>
                        <td>@classroom.Capacity</td>
                        <td>
                            @if (classroom.IsActive)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Cursos</h2>
@if (Model.Courses.Count == 0)
{
    <div class="alert alert-info">Este centro todavía no tiene cursos.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Curso</th>
                    <th>Nivel</th>
                    <th>Estado</th>
                    <th>Empieza</th>
                    <th>Termina</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model.Courses.OrderBy(c => c.StartDate))
                {
                    <tr>
                        <td>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">@course.Name</a>
                        </td>
                        <td>@Html.DisplayFor(m => course.Level)</td>
                        <td>@Html.DisplayFor(m => course.Status)</td>
                        <td><span class="badge text-bg-secondary">@course.StartDate.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="badge text-bg-secondary">@course.EndDate.ToString("dd/MM/yyyy")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
