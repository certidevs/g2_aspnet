@model List<Grade>
@{
    ViewData["Title"] = "Notas";
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Notas</h1>
    @if (isStaff)
    {
        <a class="btn btn-success" asp-action="Create">Nueva nota</a>
    }
</div>

<p>Hay @Model.Count notas.</p>



<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var grade in Model)
    {
        var badgeClass = grade.GradeEnum switch
        {
            GradeEnum.GradeA or GradeEnum.GradeB => "text-bg-success",
            GradeEnum.GradeC => "text-bg-warning",
            GradeEnum.GradeD => "text-bg-danger",
            _ => "text-bg-secondary"
        };

        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="card-title h5">@grade.Enrollment?.Course?.Name</h2>
                    @if (isStaff)
                    {
                        <p class="card-text text-secondary mb-1">
                            Alumno: @(grade.Enrollment?.Student?.DisplayName ?? grade.Enrollment?.Student?.UserName ?? "Anónimo")
                        </p>
                    }
                    <p class="card-text">Nota: @grade.Value</p>
                    <span class="badge @badgeClass">@Html.DisplayFor(m => grade.GradeEnum)</span>
                </div>
                <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@grade.Id">Ver</a>
                    @if (isStaff)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@grade.Id">Editar</a>
                        <form asp-action="Delete" asp-route-id="@grade.Id" method="post"
                              onsubmit="return confirm('¿Borrar esta nota?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>



