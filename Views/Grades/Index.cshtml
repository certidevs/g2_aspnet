@model List<Grade>
@{
    ViewData["Title"] = "Notas";
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Notas</h1>
    @if (isStaff)
    {
        <a class="btn btn-success" asp-action="Create">Nueva nota</a>
    }
</div>

<p>Hay @Model.Count notas.</p>

<table class="table table-striped">
    <thead>
        <tr>
            @if (isStaff)
            {
                <th>Alumno</th>
            }
            <th>Curso</th>
            <th>Nota</th>
            <th>Calificación</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model)
        {
            <tr>
                @if (isStaff)
                {
                    <td>@(grade.Enrollment?.Student?.DisplayName ?? grade.Enrollment?.Student?.UserName ?? "Anónimo")</td>
                }
                <td>@grade.Enrollment?.Course?.Name</td>
                <td>@grade.Value</td>
                <td>@Html.DisplayFor(m => grade.GradeEnum)</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@grade.Id">Ver</a>
                    @if (isStaff)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@grade.Id">Editar</a>
                        <form asp-action="Delete" asp-route-id="@grade.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar esta nota?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>