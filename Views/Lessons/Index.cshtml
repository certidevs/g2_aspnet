@model List<Lesson>
@{
    ViewData["Title"] = "Lecciones";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0">Lecciones</h1>
    @* DESCOMENTA: <a class="btn btn-primary" asp-action="Create">Nueva lección</a> *@
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay lecciones.</div>
}
else
{
    <p class="text-secondary">Total: @Model.Count</p>

    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Lección</th>
                    <th>Curso</th>
                    <th>Aula</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lesson in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@lesson.Id">@lesson.Name</a>
                        </td>
                        <td>
                            @if (lesson.Course is not null)
                            {
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@lesson.Course.Id">@lesson.Course.Name</a>
                            }
                        </td>
                        <td>
                            @if (lesson.Classroom is not null)
                            {
                                <a asp-controller="Classroom" asp-action="Details" asp-route-id="@lesson.Classroom.Id">@lesson.Classroom.Name</a>
                            }
                            else
                            {
                                <span class="text-secondary">Sin aula asignada</span>
                            }
                        </td>
                        <td class="text-nowrap">@lesson.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">@lesson.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@lesson.Id">Ver</a>
                            @* DESCOMENTA: <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@lesson.Id">Editar</a> *@
                            @* DESCOMENTA: <form asp-action="Delete" asp-route-id="@lesson.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta lección?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
