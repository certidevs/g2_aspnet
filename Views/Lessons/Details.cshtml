@model Lesson
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Detalle de lección</h1>
    <div class="d-flex gap-2">
        @* DESCOMENTA: <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta lección?');"><button type="submit" class="btn btn-outline-danger">Eliminar</button></form> *@
        @* DESCOMENTA: <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a> *@
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <h2 class="h4 mb-1">@Model.Name</h2>
        <p class="text-secondary">@Model.Description</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Curso</dt>
            <dd class="col-sm-9">
                @if (Model.Course is not null)
                {
                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">@Model.Course.Name</a>
                }
            </dd>
            <dt class="col-sm-3">Aula</dt>
            <dd class="col-sm-9">
                @if (Model.Classroom is not null)
                {
                    <a asp-controller="Classroom" asp-action="Details" asp-route-id="@Model.Classroom.Id">@Model.Classroom.Name</a>
                }
                else
                {
                    <span class="text-secondary">Sin aula asignada</span>
                }
            </dd>
            <dt class="col-sm-3">Inicio</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Fin</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a lecciones</a>
    </div>
</div>

<h2 class="h4">Asistencias</h2>
@if (Model.Attendances.Count == 0)
{
    <div class="alert alert-info">Todavía no se ha apuntado ninguna asistencia a esta lección.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Alumno</th>
                    <th>Asistencia</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attendance in Model.Attendances.OrderBy(a => a.Id))
                {
                    <tr>
                        <td>@(attendance.Enrollment?.Student?.DisplayName ?? attendance.Enrollment?.Student?.UserName)</td>
                        <td>@Html.DisplayFor(m => attendance.Status)</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Attendances" asp-action="Details" asp-route-id="@attendance.Id">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
