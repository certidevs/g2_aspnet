@model Exam
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo examen" : "Editar examen";
    var preguntas = ViewBag.Preguntas ?? new List<Question>();
    var preguntaActual = ViewBag.PreguntaActual ?? new Question();
    var esPrimeraPregunta = ViewBag.EsPrimeraPregunta ?? (preguntas.Count == 0);
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Save" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-8 mb-3">
            <label class="form-label" asp-for="Title">Título</label>
            <input class="form-control" asp-for="Title" />
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label" asp-for="CourseId">Curso</label>
            <select class="form-select" asp-for="CourseId" asp-items="ViewBag.Courses">
                <option value="">Selecciona un curso</option>
            </select>
            <span class="text-danger" asp-validation-for="CourseId"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Description">Descripción</label>
        <textarea class="form-control" asp-for="Description" rows="3"></textarea>
        <span class="text-danger" asp-validation-for="Description"></span>
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive">Activo</label>
    </div>

    <h3>Preguntas guardadas (@preguntas.Count)</h3>

    @if (ViewBag.HayPreguntaSinGuardar == true)
    {
        <div class="alert alert-warning">
            Tienes una pregunta sin guardar. Pulsa <strong>"Guardar pregunta"</strong> para añadirla al examen, de lo contrario se descartará.
        </div>
    }

    @foreach (var p in preguntas)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@p.Text</h5>
                <p class="card-text">
                    <strong>1.</strong> @p.Option1<br />
                    <strong>2.</strong> @p.Option2<br />
                    <strong>3.</strong> @p.Option3<br />
                    <strong>4.</strong> @p.Option4<br />
                    <strong>Correcta:</strong> Opción @p.CorrectOption
                </p>
            </div>
        </div>
    }

    <div class="border p-3 mb-3 bg-light">
        <h5>Nueva pregunta @(esPrimeraPregunta ? "(obligatoria)" : "")</h5>

        <input type="hidden" name="pregunta.ExamId" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Texto de la pregunta</label>
            <input class="form-control" name="pregunta.Text" value="@preguntaActual.Text" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Opción 1</label>
                <input class="form-control" name="pregunta.Option1" value="@preguntaActual.Option1" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Opción 2</label>
                <input class="form-control" name="pregunta.Option2" value="@preguntaActual.Option2" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Opción 3</label>
                <input class="form-control" name="pregunta.Option3" value="@preguntaActual.Option3" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Opción 4</label>
                <input class="form-control" name="pregunta.Option4" value="@preguntaActual.Option4" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Opción correcta</label>
            <select class="form-select" name="pregunta.CorrectOption">
                @if (preguntaActual.CorrectOption == 1)
                {
                    <option value="1" selected>Opción 1</option>
                }
                else
                {
                    <option value="1">Opción 1</option>
                }
                @if (preguntaActual.CorrectOption == 2)
                {
                    <option value="2" selected>Opción 2</option>
                }
                else
                {
                    <option value="2">Opción 2</option>
                }
                @if (preguntaActual.CorrectOption == 3)
                {
                    <option value="3" selected>Opción 3</option>
                }
                else
                {
                    <option value="3">Opción 3</option>
                }
                @if (preguntaActual.CorrectOption == 4)
                {
                    <option value="4" selected>Opción 4</option>
                }
                else
                {
                    <option value="4">Opción 4</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" name="accion" value="saveQuestion" class="btn btn-outline-secondary">Guardar pregunta</button>

        @if (preguntas.Count > 0)
        {
            @if (ViewBag.HayPreguntaSinGuardar == true)
            {
                <button type="submit" name="accion" value="saveExam" class="btn btn-primary"
                        onclick="return confirm('Tienes una pregunta sin guardar que no se añadirá al examen. ¿Desea continuar de todos modos?');">
                    Guardar examen
                </button>
            }
            else
            {
                <button type="submit" name="accion" value="saveExam" class="btn btn-primary">Guardar examen</button>
            }
        }
        else
        {
            <button type="submit" name="accion" value="saveExam" class="btn btn-primary" disabled>Guardar examen (necesita al menos una pregunta)</button>
        }

        <a class="btn btn-outline-secondary" asp-action="Cancelar">Cancelar examen</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
