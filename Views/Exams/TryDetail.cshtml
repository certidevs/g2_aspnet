@model ExamAttempt
@{
    ViewData["Title"] = "Attempt detail";
    var exam = Model.Exam;
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

@* View: Detail of an exam attempt.
   The teacher sees the student's answers, comments and the automatic score,
   and can modify the grade and leave their own comment. *@

<h1>Detalles del intento</h1>

@if (exam == null)
{
    <div class="alert alert-danger">Examen no encontrado.</div>
}
else
{
    <div class="mb-3">
        <strong>Examen:</strong> @exam.Title<br />
        <strong>Curso:</strong> @exam.Course?.Name<br />
        <strong>Alumno:</strong> @Model.Student?.UserName<br />
        <strong>Fecha:</strong> @Model.CompletedAt?.ToString("dd/MM/yyyy HH:mm")
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="card-title">Nota Automática: @Model.Score?.ToString("F2") / 10</h3>
        </div>
    </div>

    <h4>Respuestas del alumno</h4>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Pregunta</th>
                <th>Respuesta Alumno</th>
                <th>Justificación Alumno</th>
                <th>Resultado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var question in exam.Questions.OrderBy(q => q.Id))
            {
                var answer = Model.Answers?.FirstOrDefault(a => a.QuestionId == question.Id);
                var selectedOption = answer?.SelectedOption switch
                {
                    1 => question.Option1,
                    2 => question.Option2,
                    3 => question.Option3,
                    4 => question.Option4,
                    _ => "Not answered"
                };

                <tr>
                    <td>@question.Text</td>
                    <td>@selectedOption</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(answer?.ComentarioAlumno))
                        {
                            <span class="text-info">"@answer.ComentarioAlumno"</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (answer == null)
                        {
                            <span class="text-warning">No contestada</span>
                        }
                        else if (answer.IsCorrect)
                        {
                            <span class="text-success">✓ Correcta</span>
                        }
                        else
                        {
                            <span class="text-danger">✗ Incorrecta</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <form asp-action="TryDetail" asp-controller="Exams" method="post">
        <input type="hidden" name="attemptId" value="@Model.Id" />

        <div class="card mb-4">
            <div class="card-body">
                <h4>Revisión Profesor</h4>

                <div class="mb-3">
                    <label class="form-label">Nota del Profesor (0-10)</label>
                    <input class="form-control" name="profesorNota" type="number" step="0.01" min="0" max="10" value="@(Model.ProfesorNota.HasValue ? Model.ProfesorNota.Value.ToString("F2") : "")" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Comentarios del Profesor</label>
                    <textarea class="form-control" name="comentarioProfesor" rows="3">@Model.ComentarioProfesor</textarea>
                </div>

                <button type="submit" class="btn btn-primary">Guardar Revisión</button>
                <a class="btn btn-outline-secondary" asp-action="Validate" asp-route-id="@exam.Id">Volver a Validaciones</a>
            </div>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
