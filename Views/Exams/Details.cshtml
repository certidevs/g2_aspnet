@model Exam
@{
    ViewData["Title"] = Model.Title;
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

@* Vista: Detalle de un examen con sus preguntas.
   Muestra título, descripción, curso, profesor, fecha y estado activo.
   Solo el personal (Admin/Teacher) ve el botón de Editar examen/Añadir preguntas y la columna "Correcta". *@

<h1>@Model.Title</h1>

@* Descripción del examen *@
<p>@Html.DisplayFor(m => Model.Description)</p>

@* Información del examen: curso, profesor, fecha y estado activo *@
<div class="mb-3">
    <strong>Curso:</strong> @Model.Course?.Name<br />
    <strong>Profesor:</strong> @(Model.Teacher?.DisplayName ?? Model.Teacher?.UserName)<br />
    <strong>Fecha:</strong> @Model.CreatedAt.ToShortDateString()<br />
    <strong>Activo:</strong> @(Model.IsActive ? "Sí" : "No")
</div>

@* Botones de staff: Editar examen y Revisión examen *@
@if (isStaff)
{
    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar examen/Añadir preguntas</a>
    
    @if (Model.FechaCierre.HasValue && DateTime.UtcNow > Model.FechaCierre.Value)
    {
        <a class="btn btn-sm btn-success" asp-action="Validate" asp-route-id="@Model.Id">Revisión examen</a>
    }
}

@* Listado de preguntas del examen *@
<h3>Preguntas (@Model.Questions.Count)</h3>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Pregunta</th>
            <th>Opción 1</th>
            <th>Opción 2</th>
            <th>Opción 3</th>
            <th>Opción 4</th>
            @if (isStaff)
            {
                <th>Correcta</th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var question in Model.Questions.OrderBy(q => q.Id))
        {
            <tr>
                <td>@question.Text</td>
                <td>@question.Option1</td>
                <td>@question.Option2</td>
                <td>@question.Option3</td>
                <td>@question.Option4</td>
                @if (isStaff)
                {
                    <td>@question.CorrectOption</td>
                }
                <td>
                    @* Acciones por pregunta: Editar y Borrar (solo staff) *@
                    @if (isStaff)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary btn-edit-question" data-question-id="@question.Id">Editar</button>
                        <form asp-action="Delete" asp-controller="Questions" asp-route-id="@question.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar esta pregunta?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button>
                        </form>
                    }
                </td>
            </tr>

            @* Formulario oculto de edición de pregunta (se muestra al pulsar Editar) *@
            @if (isStaff)
            {
                <tr>
                    <td colspan="7">
                        <div class="card mb-2 edit-question-form d-none" id="edit-form-@question.Id">
                            <div class="card-body">
                                <form asp-action="SaveQuestion" asp-controller="Questions" method="post">
                                    <input type="hidden" name="Id" value="@question.Id" />
                                    <input type="hidden" name="ExamId" value="@question.ExamId" />

                                    <div class="row mb-2">
                                        <div class="col-md-9">
                                            <label class="form-label">Pregunta</label>
                                            <input class="form-control" name="Text" value="@question.Text" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end gap-2">
                                            <button type="submit" class="btn btn-primary btn-save-question">Guardar</button>
                                            <button type="button" class="btn btn-outline-secondary btn-cancel-question">Cancelar</button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-3">
                                            <input class="form-control" name="Option1" value="@question.Option1" placeholder="Opción 1" />
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" name="Option2" value="@question.Option2" placeholder="Opción 2" />
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" name="Option3" value="@question.Option3" placeholder="Opción 3" />
                                        </div>
                                        <div class="col-md-3">
                                            <input class="form-control" name="Option4" value="@question.Option4" placeholder="Opción 4" />
                                        </div>
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-3">
                                            <label class="form-label">Opción correcta</label>
                                            <select class="form-select" name="CorrectOption">
                                                @if (question.CorrectOption == 1)
                                                {
                                                    <option value="1" selected>Opción 1</option>
                                                }
                                                else
                                                {
                                                    <option value="1">Opción 1</option>
                                                }
                                                @if (question.CorrectOption == 2)
                                                {
                                                    <option value="2" selected>Opción 2</option>
                                                }
                                                else
                                                {
                                                    <option value="2">Opción 2</option>
                                                }
                                                @if (question.CorrectOption == 3)
                                                {
                                                    <option value="3" selected>Opción 3</option>
                                                }
                                                else
                                                {
                                                    <option value="3">Opción 3</option>
                                                }
                                                @if (question.CorrectOption == 4)
                                                {
                                                    <option value="4" selected>Opción 4</option>
                                                }
                                                else
                                                {
                                                    <option value="4">Opción 4</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@* Botón para volver al listado de exámenes *@
<a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.btn-edit-question').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var qid = this.getAttribute('data-question-id');

                // Ocultar todos los formularios de edición
                document.querySelectorAll('.edit-question-form').forEach(function (f) {
                    f.classList.add('d-none');
                });

                // Mostrar el formulario de esta pregunta
                var form = document.getElementById('edit-form-' + qid);
                if (form) {
                    form.classList.remove('d-none');
                }
            });
        });

        document.querySelectorAll('.btn-cancel-question').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var form = btn.closest('.edit-question-form');
                if (form) {
                    form.classList.add('d-none');
                }
            });
        });
    </script>
}
