@model List<Exam>
@{
    ViewData["Title"] = "Exámenes";
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

@* Vista: Listado de exámenes en tarjetas.
   Solo los usuarios con rol Admin o Teacher ven la columna de Profesor.
   Hacer clic en una tarjeta abre el detalle del examen.
   Solo staff puede borrar exámenes desde la esquina de cada tarjeta. *@

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Exámenes</h1>
    @if (isStaff)
    {
        <a class="btn btn-success" asp-action="Create">Nuevo examen</a>
    }
</div>

<p>Hay @Model.Count exámenes.</p>

@* Contenedor de tarjetas (grid de Bootstrap) *@
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var exam in Model)
    {
        <div class="col">
            <div class="card h-100 exam-card" data-exam-id="@exam.Id" style="cursor: pointer;">
                <div class="card-body">
                    <h5 class="card-title">@exam.Title</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@exam.Course?.Name</h6>
                    @if (isStaff)
                    {
                        <div class="mb-2"><strong>Profesor:</strong> @(exam.Teacher?.DisplayName ?? exam.Teacher?.UserName ?? "Anónimo")</div>
                    }
                    <div class="mb-2"><strong>Fecha:</strong> @exam.CreatedAt.ToShortDateString()</div>
                    <div class="mb-2"><strong>Activo:</strong> @(exam.IsActive ? "Sí" : "No")</div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    @if (isStaff)
                    {
                        <form asp-action="Delete" asp-controller="Exams" asp-route-id="@exam.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar este examen y sus preguntas?'); event.stopPropagation();">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Borrar</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.exam-card').forEach(function (card) {
            card.addEventListener('click', function (e) {
                // Si el clic proviene del botón/formulario de borrar, no redirigir
                if (e.target.closest('form')) {
                    return;
                }
                var id = this.getAttribute('data-exam-id');
        var esStaff = @Json.Serialize(User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher));
        var url = esStaff ? '/Exams/Details?id=' + id : '/Exams/Take?id=' + id;
        window.location.href = url;
            });
        });
    </script>
}
