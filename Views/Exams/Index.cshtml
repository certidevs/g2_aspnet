@model List<Exam>
@{
    ViewData["Title"] = "Exámenes";
    var isStaff = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Teacher);
}

@* Encabezado: título de la página y botón "Nuevo examen" (solo staff) *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Exámenes</h1>
    @if (isStaff)
    {
        <a class="btn btn-success" asp-action="Create">Nuevo examen</a>
    }
</div>

@* Contador de exámenes *@
<p>Hay @Model.Count exámenes.</p>

@* Tabla principal con el listado de exámenes *@
<table class="table table-striped">
    <thead>
        <tr>
            @if (isStaff)
            {
                <th>Profesor</th>
            }
            <th>Título</th>
            <th>Curso</th>
            <th>Fecha</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exam in Model)
        {
            <tr>
                @if (isStaff)
                {
                    <td>@(exam.Teacher?.DisplayName ?? exam.Teacher?.UserName ?? "Anónimo")</td>
                }
                <td>@exam.Title</td>
                <td>@exam.Course?.Name</td>
                <td>@exam.CreatedAt.ToShortDateString()</td>
                <td>@(exam.IsActive ? "Sí" : "No")</td>
                <td>
                    @* Acciones por fila: Ver, Editar y Borrar (Editar y Borrar solo staff) *@
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-controller="Exams" asp-route-id="@exam.Id">Ver</a>
                    @if (isStaff)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-controller="Exams" asp-route-id="@exam.Id">Editar</a>
                        <form asp-action="Delete" asp-controller="Exams" asp-route-id="@exam.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Borrar este examen y sus preguntas?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
