@model List<ExamAttempt>
@{
    ViewData["Title"] = "Validate Exams";
    var exam = ViewBag.Exam as Exam;
}

@* View: Validate exam attempts.
   The teacher sees the last attempt of each student for this exam
   and can review answers and comments before validating the grade. *@

<h1>Revisión examen: @(exam?.Title ?? "Examen")</h1>

@if (exam == null)
{
    <div class="alert alert-danger">Examen no encontrado.</div>
}
else
{
    <div class="mb-3">
        <strong>Curso:</strong> @exam.Course?.Name<br />
        <strong>Profesor:</strong> @(exam.Teacher?.DisplayName ?? exam.Teacher?.UserName)<br />
        <strong>Intentos máximos:</strong> @exam.MaxIntentos
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No hay intentos de examen para revisar.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Nota</th>
                    <th>Fecha de intento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var attempt in Model)
                {
                    <tr>
                        <td>@attempt.Student?.UserName</td>
                        <td>
                            @if (attempt.Score.HasValue)
                            {
                                <strong>@attempt.Score.Value.ToString("F2") / 10</strong>
                            }
                            else
                            {
                                <span class="text-muted">No evaluado</span>
                            }
                        </td>
                        <td>@attempt.CompletedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="TryDetail" asp-route-attemptId="@attempt.Id">
                                Ver detalles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
