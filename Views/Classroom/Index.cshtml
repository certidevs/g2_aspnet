@model List<Classroom>
@{
    ViewData["Title"] = "Aulas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="h2 mb-0">Aulas</h1>
    @* DESCOMENTA: <a class="btn btn-primary" asp-action="Create">Nueva aula</a> *@
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay aulas.</div>
}
else
{
    <p class="text-secondary">Total: @Model.Count</p>

    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Aula</th>
                    <th>Centro</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var classroom in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@classroom.Id">@classroom.Name</a>
                        </td>
                        <td>
                            @if (classroom.Academy is not null)
                            {
                                <a asp-controller="Academy" asp-action="Details" asp-route-id="@classroom.Academy.Id">@classroom.Academy.Name</a>
                            }
                        </td>
                        <td>@Html.DisplayFor(m => classroom.ClassroomType)</td>
                        <td>@classroom.Capacity</td>
                        <td>
                            @if (classroom.IsActive)
                            {
                                <span class="badge text-bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@classroom.Id">Ver</a>
                            @* DESCOMENTA: <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@classroom.Id">Editar</a> *@
                            @* DESCOMENTA: <form asp-action="Delete" asp-route-id="@classroom.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta aula?');"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form> *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
