@model Classroom
@{
    ViewData["Title"] = Model.Id == 0 ? "Nueva aula" : "Editar aula";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-warning">TODO (issue #20): descomenta el formulario y ajústalo</div>

<form asp-action="Save" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-8 mb-3">
            <label class="form-label" asp-for="Name">Nombre del aula</label>
            <input class="form-control" asp-for="Name" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label" asp-for="Capacity">Capacidad (plazas)</label>
            <input class="form-control" asp-for="Capacity" type="number" />
            <span class="text-danger" asp-validation-for="Capacity"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="AcademyId">Centro</label>
            <select class="form-select" asp-for="AcademyId" asp-items="ViewBag.Academies">
                <option value="0">Selecciona un centro</option>
            </select>
            <span class="text-danger" asp-validation-for="AcademyId"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="ClassroomType">Tipo de aula</label>
            <select class="form-select" asp-for="ClassroomType" asp-items="Html.GetEnumSelectList<ClassroomType>()"></select>
            <span class="text-danger" asp-validation-for="ClassroomType"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="MeetingUrl">Enlace de reunión (solo aulas telemáticas)</label>
        <input class="form-control" asp-for="MeetingUrl" type="url" />
        <span class="text-danger" asp-validation-for="MeetingUrl"></span>
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive">Aula activa</label>
    </div>

    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
