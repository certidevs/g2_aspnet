@model G2AspNet.ViewModels.Courses.CourseIndexViewModel
@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Cursos</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo curso</a>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label for="Search" class="form-label">Buscar</label>
            <input id="Search" name="search" value="@Model.Search" class="form-control"
                   placeholder="Nombre del curso" />
        </div>
        <div class="col-md-auto"><button class="btn btn-primary" type="submit">Buscar</button></div>
    </div>
</form>

@if (Model.Courses.Count == 0)
{
    <div class="alert alert-info">No hay cursos que coincidan con la búsqueda.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Curso</th>
                    <th>Descripción</th>
                    <th>Nivel</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Empieza</th>
                    <th>Termina</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Courses)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.Course.Id">
                                    @item.Course.Name
                                </a>
                            </div>
                        </td>
                        <td>@item.Course.Description</td>
                        <td>@item.Course.Level</td>
                        <td>@item.Course.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-ES"))</td>
                        <td>@item.Course.Status</td>
                        <td><span class="badge text-bg-secondary">@item.Course.StartDate.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="badge text-bg-secondary">@item.Course.EndDate.ToString("dd/MM/yyyy")</span></td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                                   asp-route-id="@item.Course.Id">Editar</a>
                            <form asp-action="Delete" asp-route-id="@item.Course.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Borrar este curso?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
