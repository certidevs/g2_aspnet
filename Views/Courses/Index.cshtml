@*Según la IA esta view esta recibiendo un Model inválido para esta view. Hay que revisar el Controller.*@

@model dynamic
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Cursos</h1>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo curso</a>
</div>

<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label for="Search" class="form-label">Buscar</label>
            <input id="Search" name="Search" value="@Model.Search" class="form-control" placeholder="Nombre del curso" />
        </div>
        <div class="col-md-auto"><button class="btn btn-primary" type="submit">Buscar</button></div>
    </div>
</form>

@if (Model.Courses.Count == 0)
{
    <div class="alert alert-info">No hay cursos que coincidan con la búsqueda.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Curso</th><th>Descripción</th><th>Empieza</th><th>Termina</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Courses)
                {
                    var name = item.Course.DisplayName ?? item.Course.Name ?? "Curso sin nombre";
                    <tr>
                        <td><div class="fw-semibold">@name</div></td>
                        <td><span class="badge text-bg-secondary">@item.Description</span></td>
                        <td><span class="badge text-bg-secondary">@item.Course.StartDate?.ToString("dd/MM/yyyy")</span></td>
                        <td><span class="badge text-bg-secondary">@item.Course.EndDate?.ToString("dd/MM/yyyy")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
