@model Course
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo curso" : "Editar curso";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Save" method="post" class="col-lg-8">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-5 mb-3">
            <label class="form-label" asp-for="Name">Curso</label>
            <input class="form-control" asp-for="Name" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <div class="col-md-7 mb-3">
            <label class="form-label" asp-for="Description">Descripción</label>
            <input class="form-control" asp-for="Description" />
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-2 mb-3">
            <label class="form-label" asp-for="Level">Nivel</label>
            <select class="form-control" asp-for="Level">
                <option value="Beginner">Principiante</option>
                <option value="Intermediate">Intermedio</option>
                <option value="Advanced">Avanzado</option>
            </select>
            <span class="text-danger" asp-validation-for="Level"></span>
        </div>
        <div class="col-md-2 mb-3">
            <label class="form-label" asp-for="Price">Precio</label>
            <input class="form-control" asp-for="Price" type="number" step="0.01" />
            <span class="text-danger" asp-validation-for="Price"></span>
        </div>
        <div class="col-md-5 mb-3">
            <label class="form-label" asp-for="MaxStudents">Máximo de estudiantes</label>
            <input class="form-control" asp-for="MaxStudents" type="number" step="1" />
            <span class="text-danger" asp-validation-for="MaxStudents"></span>
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label" asp-for="Status">Estado</label>
            <select class="form-control" asp-for="Status">
                <option value="Draft">Borrador</option>
                <option value="Open">Abierto</option>
                <option value="InProgress">En progreso</option>
                <option value="Finished">Finalizado</option>
                <option value="Cancelled">Cancelado</option>
            </select>
            <span class="text-danger" asp-validation-for="Status"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="StartDate">Fecha de inicio</label>
            <input class="form-control" asp-for="StartDate" type="date" />
            <span class="text-danger" asp-validation-for="StartDate"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="EndDate">Fecha de finalización</label>
            <input class="form-control" asp-for="EndDate" type="date" />
            <span class="text-danger" asp-validation-for="EndDate"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 mb-3">
            <button class="btn btn-primary" type="submit">Guardar</button>
        </div>
        <div class="col-md-3 mb-3">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
